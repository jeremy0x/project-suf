CONVEX_DEPLOYMENT=dev:your-deployment-name       # npx convex dev pushes code here
VITE_CONVEX_URL=https://your-deployment.convex.cloud    # Frontend connects to this Convex backend
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
VITE_ADMIN_PASSWORD=your-admin-password           # Password for /admin

# Convex env vars (set via `npx convex env set`, not this file):
#   TINYPNG_API_KEY  — image compression (required for uploads)
#   IMGBB_API_KEY    — image CDN hosting (required for uploads)
