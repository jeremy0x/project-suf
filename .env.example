CONVEX_DEPLOYMENT=dev:your-deployment-name       # npx convex dev pushes code here
VITE_CONVEX_URL=https://your-deployment.convex.cloud    # Frontend connects to this Convex backend
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Admin password is set via Convex env var (not in this file):
#   npx convex env set ADMIN_PASSWORD your_password
